<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- Whole visible-process inventory requires UID-to-package candidates beyond a fixed queries list.
         Metadata only, on explicit refresh; no content reading or inventory upload. Sideload preview. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- Special app-op access is granted by the user's Usage Access settings, not a runtime
         signature permission. Capability is checked and SecurityException fails closed. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <application android:name=".SentinelApp" android:label="欧南·网络哨兵（隔离测试）"
        android:theme="@style/Theme.Sentinel" android:allowBackup="false" android:dataExtractionRules="@xml/local_data_rules"
        android:supportsRtl="true" android:icon="@drawable/ic_sentinel">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ResourceDiagnosticActivity" android:exported="false" />
        <service android:name=".MonitorService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started visible local monitoring of selected system component process and AppOps state via Shizuku; no content capture or network traffic capture." />
        </service>
        <provider android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku" android:enabled="true"
            android:exported="true" android:multiprocess="false" android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
